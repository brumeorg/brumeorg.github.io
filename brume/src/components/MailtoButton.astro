---
import { mailto, type Lang, type MailIntent } from '../i18n/cta';

interface Props {
	intent: MailIntent;
	/** Short page id, written in the mail subject (e.g. `enterprise`). */
	page: string;
	lang?: Lang;
}

const { intent, page } = Astro.props;
const lang: Lang = Astro.props.lang ?? (Astro.locals.starlightRoute.lang === 'fr' ? 'fr' : 'en');
---

<a class="brume-btn brume-btn-primary" href={mailto(lang, intent, page)}><slot /></a>
