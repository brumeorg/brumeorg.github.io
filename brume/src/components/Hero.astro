---
/**
 * Override of Starlight's Hero. The `brume <cmd>` typewriter stays as the
 * visual headline but is no longer the <h1>: the page's keyword title
 * (`hero.title`) is rendered as the real <h1> just below it, for SEO.
 * Only `hero.image.html` is supported — the only image form the site uses.
 *
 * Additions: `heroNote` (frontmatter) prints a small line under the buttons,
 * and an action with `attrs: { data-mail-intent, data-mail-page }` gets its
 * mailto link (subject + body) from src/i18n/cta.ts.
 */
import { LinkButton } from '@astrojs/starlight/components';
import { mailto, type MailIntent } from '../i18n/cta';

const { entry, lang } = Astro.locals.starlightRoute;
const { data } = entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const rawHtml = image && 'html' in image ? image.html : undefined;
const heroNote = (data as { heroNote?: string }).heroNote;

const resolveLink = (link: string, attrs: Record<string, unknown>) => {
	const { 'data-mail-intent': intent, 'data-mail-page': page, ...rest } = attrs;
	const href = intent
		? mailto(lang === 'fr' ? 'fr' : 'en', intent as MailIntent, String(page))
		: link;
	return { href, rest };
};
---

<div class="hero">
	{rawHtml && <div class="hero-html sl-flex" set:html={rawHtml} />}
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<p class="brume-hero-cli" aria-hidden="true">
				<Fragment
					set:html={'<span class="brume-cli"><span class="brume-cli-prompt">brume</span> <span class="brume-cli-cmd" id="brume-cli-cmd">plan</span><span class="brume-caret"></span></span>'}
				/>
			</p>
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => {
						const { href, rest } = resolveLink(link, attrs);
						return (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...rest}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						);
					})}
				</div>
			)
		}
		{heroNote && <p class="hero-note" set:html={heroNote} />}
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 1rem;
			padding-bottom: 1rem;
		}

		.hero > .hero-html {
			object-fit: contain;
			width: min(70%, 20rem);
			height: auto;
			margin-inline: auto;
		}

		.stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.copy > * {
			max-width: 50ch;
		}

		.brume-hero-cli {
			margin: 0;
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: 0.95;
			color: var(--sl-color-white);
		}

		h1 {
			font-size: clamp(var(--sl-text-xl), calc(0.5rem + 1.6vw), var(--sl-text-3xl));
			line-height: 1.15;
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.hero-note {
			margin: calc(-0.5 * clamp(1.5rem, calc(1.5rem + 1vw), 2rem)) 0 0;
			font-size: var(--sl-text-sm);
			color: var(--brume-muted-text);
		}

		@media (min-width: 50rem) {
			.hero {
				grid-template-columns: 7fr 4fr;
				gap: 3%;
				padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
			}

			.hero > .hero-html {
				order: 2;
				width: min(100%, 25rem);
			}

			.stack {
				text-align: start;
			}

			.copy {
				align-items: flex-start;
			}

			.actions {
				justify-content: flex-start;
			}
		}
	}
</style>
